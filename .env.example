# PostgreSQL connection. A URL-encoded username/password can be used here.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/feira_sustentavel

# Firebase project used to validate client ID tokens.
FIREBASE_PROJECT_ID=intelligent-surf-853bd

# Comma-separated Google accounts allowed to use coordinator-only API routes.
COORDINATOR_EMAILS=coordenacao@example.org

# Optional path to a Firebase Admin service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json

# Set to true only when initializing a new database schema explicitly.
