# PostgreSQL connection. A URL-encoded username/password can be used here.
DATABASE_URL=sqlite:///./feira_sustentavel.db

# Origens que podem acessar a API a partir do navegador (separadas por vírgula).
# Para implantação, informe a URL do site GitHub Pages e não use *.
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# Para usar PostgreSQL em produção, substitua pela URL do banco:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/feira_sustentavel

# Set to true only when initializing a new database schema explicitly.
